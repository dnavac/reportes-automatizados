{
  "name": "Generador de Reportes Inmobiliarios (Easypanel HTTP API)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 7
            }
          ]
        }
      },
      "id": "1-schedule-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT estado, COUNT(*) as cantidad FROM leads WHERE fecha >= current_date - interval '7 days' GROUP BY estado;"
      },
      "id": "2-postgres-leads",
      "name": "Query Leads Semana",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        200,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT estado, COUNT(*) as cantidad, AVG(precio) as precio_promedio FROM propiedades GROUP BY estado;"
      },
      "id": "3-postgres-propiedades",
      "name": "Query Propiedades",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        200,
        400
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "mergeByPosition"
      },
      "id": "4-merge-node",
      "name": "Merge Queries",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://reportes-api:8000/generar-reporte",
        "responseFormat": "file",
        "outputPropertyName": "reporte_pdf"
      },
      "id": "5-http-request-python",
      "name": "Generar Reporte API (Python)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        600,
        300
      ]
    },
    {
      "parameters": {
        "sendTo": "gerencia@inmobiliaria.com",
        "subject": "Reporte Semanal de Ventas y Leads",
        "message": "Adjunto el reporte semanal automatizado de la inmobiliaria.",
        "attachments": "reporte_pdf"
      },
      "id": "8b-send-email-success",
      "name": "Enviar Reporte Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [
        850,
        200
      ]
    },
    {
      "parameters": {
        "channel": "reportes-ventas",
        "text": "Reporte semanal inmobiliario generado y enviado por correo exitosamente ✅"
      },
      "id": "9-slack-notify",
      "name": "Notificación Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [
        1100,
        200
      ]
    }
  ],
  "connections": {
